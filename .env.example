# Local POC Environment Template (never commit real .env or customer data)
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
APP_MASTER_KEY=REPLACE_WITH_FERNET_KEY

# Optional LLM Provider API Keys (leave blank for setup_required status)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
MOONSHOT_API_KEY=
NVIDIA_NIM_API_KEY=

# Use "legacy" to temporarily switch specialist execution back to the prior tool loop.
AGENT_RUNTIME=deepagents

# Compose uses the Celery worker for run execution; use "inline" for local API-owned execution.
RUN_EXECUTION_MODE=celery
# Seconds before a run held by a crashed worker is re-delivered; must exceed the longest run (default 900).
# RUN_REDELIVERY_SECONDS=900
# APP_MASTER_KEY may list several Fernet keys, newest first and comma-separated, during a rotation;
# run `make rotate-keys` to re-encrypt saved keys with the newest one, then drop the old key.

# Set by docker-compose; set these yourself only when running the API or worker outside compose.
# DATABASE_URL=postgresql+psycopg://postgres:REPLACE_WITH_STRONG_PASSWORD@localhost:5432/analytics_poc
# REDIS_URL=redis://localhost:6379/0
# ARTIFACT_ROOT=./data/artifacts
# CORS_ALLOW_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# CORS_ALLOW_ORIGIN_REGEX=  # Optional; unset by default so only exact CORS_ALLOW_ORIGINS are permitted.

# Optional
# EXPORT_RETENTION_DAYS=7
# APP_UNICODE_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
# APP_UNICODE_FONT_BOLD=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
# LOG_LEVEL=INFO
# LOG_FORMAT=text
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=ledgerline-api

# Frontend (build time)
# NEXT_PUBLIC_API_BASE=/api/v1
# NEXT_PUBLIC_WORKSPACE_ID=ws1
# Optional daily limits per workspace (the day starts at midnight in the workspace's business time zone)
# WORKSPACE_DAILY_RUN_LIMIT=200
# WORKSPACE_DAILY_COST_LIMIT_USD=25
# Investigations the API runs at the same time, and how many may wait in the queue (defaults 1 and 10).
# MAX_ACTIVE_RUNS=1
# MAX_QUEUED_RUNS=10
