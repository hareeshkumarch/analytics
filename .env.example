# Local POC Environment Template (never commit real .env or customer data)
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
APP_MASTER_KEY=REPLACE_WITH_FERNET_KEY

# Optional LLM Provider API Keys (leave blank for setup_required status)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
MOONSHOT_API_KEY=
NVIDIA_NIM_API_KEY=

# Use "legacy" to temporarily switch specialist execution back to the prior tool loop.
AGENT_RUNTIME=deepagents

# Compose uses the Celery worker for run execution; use "inline" for local API-owned execution.
RUN_EXECUTION_MODE=celery
