FROM node:22-alpine

WORKDIR /app

# NEXT_PUBLIC_* values and next.config.ts rewrites are evaluated at build time, so they
# must be build arguments; setting them as runtime environment variables has no effect.
ARG NEXT_PUBLIC_API_BASE=/api/v1
ARG API_PROXY_ORIGIN=
ENV NEXT_PUBLIC_API_BASE=$NEXT_PUBLIC_API_BASE
ENV API_PROXY_ORIGIN=$API_PROXY_ORIGIN

COPY frontend/package.json frontend/package-lock.json /app/
RUN npm ci
COPY frontend /app
RUN npm run build

USER node
EXPOSE 3000
CMD ["npm", "run", "start"]
