FROM node:22-alpine

WORKDIR /app

# NEXT_PUBLIC_* values are inlined into the browser bundle at build time, so they must be
# build arguments; setting them as runtime environment variables has no effect.
ARG NEXT_PUBLIC_API_BASE=http://127.0.0.1:8080/api/v1
ENV NEXT_PUBLIC_API_BASE=$NEXT_PUBLIC_API_BASE

COPY frontend/package.json frontend/package-lock.json /app/
RUN npm ci
COPY frontend /app
RUN npm run build

USER node
EXPOSE 3000
CMD ["npm", "run", "start"]
