FROM python:3.13-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --shell /bin/bash appuser
WORKDIR /app

COPY backend/requirements.lock /app/requirements.lock
RUN pip install --no-cache-dir --require-hashes -r requirements.lock
COPY backend /app
COPY fixtures/inr_acceptance /app/samples/inr_acceptance
RUN pip install --no-cache-dir --no-deps . && pip check

ENV PYTHONPATH=/app
ENV SAMPLE_DATA_DIR=/app/samples

RUN mkdir -p /data/artifacts /data/locks && chown -R appuser:appuser /app /data
USER appuser

EXPOSE 8000
